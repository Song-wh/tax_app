# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# ===== 데이터 소스 =====
# mock  : 샘플 데이터 (키 없이 동작)
# codef : CODEF API로 실제 홈택스/위택스 조회
DATA_SOURCE=mock

# ===== Claude API (AI 분석) =====
# https://console.anthropic.com > API Keys 에서 발급 (sk-ant-... 형태)
ANTHROPIC_API_KEY=

# ===== CODEF (홈택스/위택스 조회) =====
# https://codef.io 가입 > 마이페이지/키 관리 에서 확인
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# RSA 공개키 (한 줄 그대로 붙여넣기)
CODEF_PUBLIC_KEY=
# sandbox(가짜 응답) | demo(실데이터, 테스트 한도) | production(정식)
CODEF_ENV=sandbox
